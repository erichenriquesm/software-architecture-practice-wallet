# Development values for the containers in docker/docker-compose.yml. Copy to .env: cp .env.example .env
API_PORT=3000
HEALTH_PORT=3001

DATABASE_HOST=wallet-db
DATABASE_PORT=5432
DATABASE_NAME=wallet
# One user per service: it owns the database, runs the migrations and reads/writes the data
DATABASE_USER=wallet
DATABASE_PASSWORD=wallet-db-dev

RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=wallet
RABBITMQ_PASSWORD=wallet-rabbitmq-dev

REDIS_HOST=redis
REDIS_USER=wallet
REDIS_PASSWORD=wallet-redis-dev

ACCOUNT_GRPC_ADDR=account-api:50051
# Shared internal gRPC token, sent as x-service-token (the account service checks it)
ACCOUNT_GRPC_TOKEN=internal-grpc-dev

# Dev Ed25519 public key that verifies the user JWT the edge forwards (the account service signs it)
USER_TOKEN_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEALxCEnICerfG52kOtFCaYrwczs5XMniydqmd9Si/Pf2I=\n-----END PUBLIC KEY-----\n

RATE_LIMITS_MOVEMENT_PER_IP=30/1m
RATE_LIMITS_MOVEMENT_PER_ACCOUNT=10/1m

LOG_LEVEL=debug
